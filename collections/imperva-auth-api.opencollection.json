{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cloud Application Security Account Management Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-API-Key",
      "value": "{{x-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getRole",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://my.imperva.com/v1/auth/session/roles"
          }
        },
        {
          "info": {
            "name": "getSessionId",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://my.imperva.com/v1/auth/session",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ]
          }
        },
        {
          "info": {
            "name": "logout",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://my.imperva.com/v1/auth/session"
          }
        }
      ]
    }
  ],
  "bundled": true
}